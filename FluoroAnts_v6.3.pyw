_PAYLOAD_SHA256 = "bacd4ee1876a0034f541339c90d67c29a97f27231d9f83d4093b35b0ea290278"
_CACHE_KEEP_DAYS = 30
# Modules the embedded program imports at start-up or when the learned engine
# runs.  SciPy is only needed by the learned model, but reporting it here means
# a missing install shows one friendly dialog instead of a traceback deep
# inside the interface.
_DEPENDENCIES = (
    ("numpy", "NumPy", "numpy"),
    ("cv2", "OpenCV", "opencv-python"),
    ("scipy", "SciPy", "scipy"),
    ("PySide6", "PySide6", "PySide6"),
)


def _chinese() -> bool:
    """Whether the launcher's own messages should be in Chinese.

    The program proper has its language pack; the launcher only needs the few
    messages it shows before the program can start.
    """

    code = os.environ.get("FLUOROANTS_LANG", "")
    arguments = sys.argv[1:]
    for index, value in enumerate(arguments):
        if value == "--lang" and index + 1 < len(arguments):
            code = arguments[index + 1]
        elif value.startswith("--lang="):
            code = value.split("=", 1)[1]
    if code:
        return code.lower().startswith("zh")
    if sys.platform == "win32":
        try:
            language_id = ctypes.windll.kernel32.GetUserDefaultUILanguage()  # type: ignore[attr-defined]
            return (language_id & 0x3FF) == 0x04
        except Exception:
            pass
    return any(
        os.environ.get(name, "").lower().startswith("zh")
        for name in ("LC_ALL", "LC_MESSAGES", "LANGUAGE", "LANG")
    )


def _text(english: str, chinese: str) -> str:
    return chinese if _chinese() else english


def _message(title: str, body: str, *, error: bool = False) -> None:
    flags = 0x10 if error else 0x40
    try:
        ctypes.windll.user32.MessageBoxW(None, body, title, flags)  # type: ignore[attr-defined]
    except Exception:
        try:
            print(f"{title}\n{body}", file=sys.stderr)
        except Exception:
            pass


def _check_dependencies() -> None:
    missing: list[tuple[str, str]] = []
    for module_name, display_name, pip_name in _DEPENDENCIES:
        try:
            __import__(module_name)
        except ImportError:
            missing.append((display_name, pip_name))
    if missing:
        command = "pip install " + " ".join(pip for _name, pip in missing)
        raise RuntimeError(
            _text(
                "This computer lacks components the program needs: "
                + ", ".join(name for name, _pip in missing)
                + ".\n\nInstall these Python packages on the command line, "
                "then start this file again:\n",
                "当前电脑缺少运行组件："
                + "、".join(name for name, _pip in missing)
                + "。\n\n请先在命令行中安装这些 Python 组件，再双击本文件：\n",
            )
            + command
        )


def _decode_payload() -> bytes:
    payload = base64.b85decode("".join(_PAYLOAD.split()).encode("ascii"))
    if hashlib.sha256(payload).hexdigest() != _PAYLOAD_SHA256:
        raise RuntimeError(
            _text(
                "The embedded program failed its integrity check; this file may be damaged "
                "or modified. Please obtain it again.",
                "内置程序包校验失败，本文件可能已损坏或被修改；请重新获取。",
            )
        )
    return payload


def _extract(payload: bytes, target: Path) -> None:
    target.mkdir(parents=True, exist_ok=True)
    with zipfile.ZipFile(io.BytesIO(payload), "r") as archive:
        archive.extractall(target)


def _cache_root() -> Path | None:
    if sys.platform == "win32":
        base = os.environ.get("LOCALAPPDATA") or os.environ.get("APPDATA")
    else:
        base = os.environ.get("XDG_CACHE_HOME") or str(Path.home() / ".cache")
    if not base:
        return None
    return Path(base) / "FluoroAnts" / "runtime"


def _runtime_is_complete(target: Path) -> bool:
    """A cached copy is usable when its marker names this exact archive."""

    try:
        marker = (target / ".ready").read_text(encoding="ascii").strip()
    except (OSError, UnicodeDecodeError):
        return False
    return (
        marker == _PAYLOAD_SHA256
        and (target / "app.py").is_file()
        and (target / "fluoro_ants" / "__init__.py").is_file()
    )


def _prune_stale_runtimes(root: Path, keep: Path) -> None:
    """Best effort: drop unpacked copies of old versions that were not used lately."""

    cutoff = time.time() - _CACHE_KEEP_DAYS * 86400
    try:
        entries = list(root.iterdir())
    except OSError:
        return
    for entry in entries:
        if entry == keep or not entry.is_dir():
            continue
        try:
            if entry.stat().st_mtime < cutoff:
                shutil.rmtree(entry, ignore_errors=True)
        except OSError:
            continue


def _prepare_runtime() -> Path:
    digest = _PAYLOAD_SHA256[:20]
    root = _cache_root()
    if root is not None:
        try:
            target = root / digest
            if not _runtime_is_complete(target):
                staging = root / f".{digest}.{os.getpid()}.tmp"
                shutil.rmtree(staging, ignore_errors=True)
                _extract(_decode_payload(), staging)
                (staging / ".ready").write_text(_PAYLOAD_SHA256, encoding="ascii")
                try:
                    os.replace(staging, target)
                except OSError:
                    # Another instance unpacked the same version first; keep
                    # its copy and discard ours.
                    shutil.rmtree(staging, ignore_errors=True)
                    if not _runtime_is_complete(target):
                        raise
            if _runtime_is_complete(target):
                try:
                    os.utime(target, None)
                except OSError:
                    pass
                _prune_stale_runtimes(root, keep=target)
                return target
        except Exception:
            pass
    run_root = Path(tempfile.mkdtemp(prefix="FluoroAnts_Universal_"))
    atexit.register(shutil.rmtree, run_root, ignore_errors=True)
    _extract(_decode_payload(), run_root)
    return run_root


def _run() -> int:
    if sys.version_info < (3, 10):
        version = ".".join(str(part) for part in sys.version_info[:3])
        raise RuntimeError(
            _text(
                f"Python 3.10 or later is required; this is Python {version}.",
                f"需要 Python 3.10 或更高版本；当前为 {version}。",
            )
        )
    _check_dependencies()
    run_root = _prepare_runtime()
    sys.path.insert(0, str(run_root))

    import app

    return int(app.main(sys.argv[1:]))


if __name__ == "__main__":
    try:
        raise SystemExit(_run())
    except SystemExit:
        raise
    except Exception as exc:
        details = "".join(traceback.format_exception_only(type(exc), exc)).strip()
        _message(
            _text("FluoroAnts Universal could not start", "FluoroAnts Universal 启动失败"),
            _text("The program could not start.", "程序未能启动。") + "\n\n" + details,
            error=True,
        )
